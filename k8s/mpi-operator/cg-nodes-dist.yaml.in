apiVersion: kubeflow.org/v2beta1
kind: MPIJob
metadata:
  name: ${JOB_NAME}
  labels:
    experiment: node-scaling-dist
    node-count: "${NODE_COUNT}"
    variant: distributed
spec:
  slotsPerWorker: 1
  mpiImplementation: MPICH
  sshAuthMountPath: /home/mpiuser/.ssh
  launcherCreationPolicy: WaitForWorkersReady
  runPolicy:
    cleanPodPolicy: Running
    activeDeadlineSeconds: 3600
  mpiReplicaSpecs:
    Launcher:
      replicas: 1
      template:
        spec:
          nodeSelector:
            kubernetes.io/arch: arm64
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: kubernetes.io/hostname
                        operator: In
                        values: [${LAUNCHER_POOL}]
          containers:
            - name: cg-launcher
              image: srmarinho/cg-mpi:arm64-dist
              imagePullPolicy: Always
              securityContext:
                runAsUser: 1000
              env:
                - name: OMP_NUM_THREADS
                  value: "${OMP_THREADS}"
                - name: OMP_PROC_BIND
                  value: close
                - name: OMP_PLACES
                  value: cores
              args:
                - mpirun
                - -n
                - "${MPI_PROCS}"
                - /opt/cg/bin/cg_mpi_distributed
                - --matrix
                - /opt/cg/matrices/${MATRIX}/${MATRIX}.mtx
                - --block-size
                - "${BLOCK_SIZE}"
                - --threads
                - "${OMP_THREADS}"
                - --tol
                - "1e-8"
                - --max-iters
                - "10000"
              resources:
                limits:
                  cpu: "1"
                  memory: 512Mi
                requests:
                  cpu: "200m"
                  memory: 256Mi
    Worker:
      replicas: ${MPI_PROCS}
      template:
        spec:
          nodeSelector:
            kubernetes.io/arch: arm64
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: kubernetes.io/hostname
                        operator: In
                        values: [${NODE_POOL}]
            podAntiAffinity:
              ${WORKER_ANTI_AFFINITY}
          containers:
            - name: cg-worker
              image: srmarinho/cg-mpi:arm64-dist
              imagePullPolicy: Always
              securityContext:
                runAsUser: 1000
              env:
                - name: OMP_NUM_THREADS
                  value: "${OMP_THREADS}"
                - name: OMP_PROC_BIND
                  value: close
                - name: OMP_PLACES
                  value: cores
              command: [/usr/sbin/sshd]
              args: [-De, -f, /home/mpiuser/.sshd_config]
              readinessProbe:
                tcpSocket:
                  port: 2222
                initialDelaySeconds: 2
              resources:
                limits:
                  cpu: "${WORKER_CPU}"
                  memory: 512Mi
                requests:
                  cpu: "200m"
                  memory: 256Mi
